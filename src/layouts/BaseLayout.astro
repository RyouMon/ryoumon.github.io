---
import { GitFork, Mail } from '@lucide/astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
  SITE_AUTHOR,
  SITE_DESCRIPTION,
  SITE_EMAIL,
  SITE_GITHUB,
  SITE_TITLE,
} from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;
const documentTitle = title === SITE_TITLE ? title : `${title} | ${SITE_TITLE}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE_AUTHOR} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="theme-color" content="#f7f8ff" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/images/avatar.png" />
    <title>{documentTitle}</title>
    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem('wen-theme');
        const preferredTheme = window.matchMedia('(prefers-color-scheme: dark)').matches
          ? 'dark'
          : 'light';
        document.documentElement.dataset.theme = savedTheme || preferredTheme;
      })();
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col bg-background font-sans text-base leading-[1.72] text-foreground [overflow-wrap:break-word]"
  >
    <a
      class="fixed top-4 left-4 z-200 -translate-y-[220%] rounded-[10px] bg-surface px-[0.85rem] py-[0.55rem] font-bold text-accent-strong no-underline shadow-card focus:translate-y-0"
      href="#main-content">跳到正文</a
    >
    <SiteHeader />
    <main
      id="main-content"
      class:list={[
        'min-h-[60vh] flex-1',
        isHome
          ? 'w-full p-0'
          : 'page-frame pt-12 pb-24 max-nav:pt-[2.3rem] max-nav:pb-[4.5rem]',
      ]}
    >
      <slot />
    </main>
    <footer class="mt-auto w-full bg-footer text-footer-foreground">
      <div
        class="page-frame grid grid-cols-[minmax(0,1fr)_auto] items-end gap-8 pt-13 pb-9 max-nav:grid-cols-1 max-nav:items-start max-nav:pt-10 max-nav:pb-8"
      >
        <div>
          <strong class="block text-[2.1rem] leading-none font-[860] tracking-[-0.06em]">
            Wen<span class="text-secondary" aria-hidden="true">.</span>
          </strong>
          <p class="mt-[0.55rem] mb-0 max-w-[34rem] text-[0.9rem] text-white/68">
            个人项目、文章与开发笔记。
          </p>
        </div>
        <div class="grid justify-items-end gap-[0.7rem] max-nav:justify-items-start">
          <div class="flex items-center gap-[0.4rem]">
            <a
              class="inline-grid size-10 place-items-center rounded-full bg-white/8 text-footer-foreground no-underline transition hover:-translate-y-[3px] hover:-rotate-4 hover:bg-white/16"
              href={SITE_GITHUB}
              aria-label="GitHub"
              title="GitHub"
            >
              <GitFork size={20} stroke-width={2} />
            </a>
            <a
              class="inline-grid size-10 place-items-center rounded-full bg-white/8 text-footer-foreground no-underline transition hover:-translate-y-[3px] hover:-rotate-4 hover:bg-white/16"
              href={`mailto:${SITE_EMAIL}`}
              aria-label="发送邮件"
              title={SITE_EMAIL}
            >
              <Mail size={20} stroke-width={2} />
            </a>
          </div>
          <p class="m-0 text-[0.76rem] text-white/58">
            © {new Date().getFullYear()} {SITE_AUTHOR}. 保留所有权利。
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
