---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  pubDate?: Date;
}

const { title, description, pubDate } = Astro.props;
const formattedDate = pubDate
  ? new Intl.DateTimeFormat('zh-CN', { dateStyle: 'long' }).format(pubDate)
  : undefined;
---

<BaseLayout title={title} description={description}>
  <div class="fixed inset-x-0 top-0 z-180 h-1 bg-transparent" aria-hidden="true">
    <span class="block h-full w-0 rounded-r-full bg-accent" data-reading-progress></span>
  </div>
  <article class="w-full">
    <a
      class="group mb-[2.7rem] inline-flex items-center gap-[0.45rem] text-[0.88rem] font-[720] text-muted-foreground no-underline hover:text-accent-strong"
      href="/blog/"
    >
      <span class="transition-transform duration-150 group-hover:-translate-x-1" aria-hidden="true">
        ←
      </span>
      返回文章
    </a>
    <header>
      <h1
        class="m-0 inline-block text-[clamp(2.5rem,7vw,4.25rem)] leading-[1.02] font-[860] tracking-[-0.065em] text-accent-strong"
      >
        {title}
      </h1>
      {
        formattedDate && (
          <time
            class="mt-[0.8rem] block text-[0.86rem] font-bold text-muted-foreground"
            datetime={pubDate?.toISOString()}
          >
            {formattedDate}
          </time>
        )
      }
    </header>
    <div class="prose mt-10">
      <slot />
    </div>
  </article>
</BaseLayout>

<script>
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');

  const updateReadingProgress = () => {
    if (!progress) return;

    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const percentage = height > 0 ? (window.scrollY / height) * 100 : 0;
    progress.style.width = `${Math.min(100, Math.max(0, percentage))}%`;
  };

  updateReadingProgress();
  window.addEventListener('scroll', updateReadingProgress, { passive: true });
</script>
