---
interface Props {
  current: string;
  parent?: {
    label: string;
    href: string;
  };
}

const { current, parent } = Astro.props;
---

<nav class="breadcrumb" aria-label="面包屑导航">
  <a href="/" aria-label="返回首页">~</a>
  <span aria-hidden="true">/</span>
  {
    parent && (
      <>
        <a href={parent.href}>{parent.label}</a>
        <span aria-hidden="true">/</span>
      </>
    )
  }
  <span aria-current="page">{current}</span>
</nav>
