---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  id?: string;
  class?: string;
}

const { project, id, class: className } = Astro.props;
const headingId = id ? `${id}-heading` : 'project-install-heading';
---

{
  project.data.url && project.data.qrCode && (
    <section
      id={id}
      class:list={[
        'grid grid-cols-[minmax(0,1fr)_10.5rem] items-center gap-6 rounded-3xl border border-accent/25 bg-[radial-gradient(circle_at_100%_0%,color-mix(in_srgb,var(--accent)_17%,transparent),transparent_38%),linear-gradient(145deg,var(--surface-raised),var(--accent-soft))] p-[clamp(1.25rem,4vw,1.8rem)] shadow-card max-nav:grid-cols-1',
        className,
      ]}
      aria-labelledby={headingId}
    >
      <div class="min-w-0">
        <div class="flex items-center gap-4 max-[480px]:items-start">
          {
            project.data.icon && (
              <img
                class="size-[4.5rem] shrink-0 rounded-[22%] shadow-[0_10px_24px_color-mix(in_srgb,var(--foreground)_16%,transparent)] max-[480px]:size-[3.8rem]"
                src={project.data.icon}
                alt=""
                width="1024"
                height="1024"
                loading="lazy"
              />
            )
          }
          <div>
            <p class="m-0 text-[0.66rem] font-[850] tracking-[0.1em] text-accent-strong">
              AVAILABLE ON THE APP STORE
            </p>
            <h2
              id={headingId}
              class="mt-[0.22rem] mb-0 text-[clamp(1.35rem,4vw,1.75rem)] leading-[1.15] tracking-[-0.04em]"
            >
              安装 {project.data.title}
            </h2>
          </div>
        </div>
        <p class="mt-[1.1rem] mb-0 max-w-[30rem] text-[0.88rem] leading-[1.65] text-muted-foreground">
          点击按钮前往 App Store，或使用 iPhone / iPad 相机扫描二维码。
        </p>
        <a
          class="mt-[1.1rem] inline-flex min-h-[2.8rem] items-center gap-[0.45rem] rounded-[11px] bg-accent px-[0.95rem] py-2 text-[0.86rem] font-[820] text-white no-underline shadow-[0_9px_20px_color-mix(in_srgb,var(--accent)_22%,transparent)] transition-[box-shadow,transform] duration-[180ms] hover:-translate-y-0.5 hover:shadow-[0_12px_24px_color-mix(in_srgb,var(--accent)_30%,transparent)]"
          href={project.data.url}
          target="_blank"
          rel="noreferrer"
        >
          {project.data.urlLabel ?? '前往 App Store'}
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <a
        class="grid justify-items-center gap-[0.45rem] rounded-[18px] border border-border/70 bg-white p-[0.65rem] text-[0.72rem] font-extrabold text-[#34396f] no-underline shadow-[0_10px_24px_rgb(39_43_94/0.12)] transition-[box-shadow,transform] duration-[180ms] hover:-translate-y-[3px] hover:rotate-[0.5deg] hover:shadow-[0_14px_28px_rgb(39_43_94/0.18)] max-nav:grid-cols-[7rem_minmax(0,1fr)] max-nav:justify-items-start max-[480px]:grid-cols-[5.5rem_minmax(0,1fr)]"
        href={project.data.url}
        target="_blank"
        rel="noreferrer"
        aria-label={`${project.data.urlLabel ?? '前往 App Store'}：${project.data.title}`}
      >
        <img
          class="h-auto w-full rounded-[10px] border-0 shadow-none max-nav:w-28 max-[480px]:w-[5.5rem]"
          src={project.data.qrCode}
          alt={project.data.qrCodeAlt ?? `${project.data.title} App Store 安装二维码`}
          width="512"
          height="512"
          loading="lazy"
        />
        <span>扫码安装</span>
      </a>
    </section>
  )
}
