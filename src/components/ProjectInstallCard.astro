---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  id?: string;
  class?: string;
}

const { project, id, class: className } = Astro.props;
const headingId = id ? `${id}-heading` : 'project-install-heading';
---

{
  project.data.url && project.data.qrCode && (
    <section
      id={id}
      class:list={[
        'grid grid-cols-[minmax(0,1fr)_10.5rem] items-center gap-8 border-t border-border pt-[clamp(1.5rem,4vw,2rem)] max-nav:grid-cols-1',
        className,
      ]}
      aria-labelledby={headingId}
    >
      <div class="min-w-0">
        <h2
          id={headingId}
          class="m-0 text-[clamp(1.35rem,4vw,1.75rem)] leading-[1.15] tracking-[-0.04em]"
        >
          安装 {project.data.title}
        </h2>
        <p class="mt-[1.1rem] mb-0 max-w-[30rem] text-[0.88rem] leading-[1.65] text-muted-foreground">
          点击按钮前往 App Store，或使用 iPhone / iPad 相机扫描二维码。
        </p>
        <a
          class="mt-[1.1rem] inline-block leading-none focus-visible:rounded-[0.35rem] focus-visible:outline-2 focus-visible:outline-offset-[0.45rem] focus-visible:outline-accent-strong"
          href={project.data.url}
          target="_blank"
          rel="noreferrer"
          aria-label={`${project.data.urlLabel ?? '在 App Store 下载'}：${project.data.title}`}
        >
          <img
            class="block h-12 w-auto"
            src="/images/app-store/download-on-the-app-store.svg"
            alt=""
            width="120"
            height="40"
            loading="lazy"
          />
        </a>
        <p class="mt-[1rem] mb-0 max-w-[34rem] text-[0.66rem] leading-[1.6] text-muted-foreground">
          Apple 和 Apple 标志是 Apple Inc. 在美国及其他国家和地区注册的商标。App Store
          是 Apple Inc. 的服务标志。
        </p>
      </div>

      <a
        class="grid justify-items-center gap-[0.45rem] text-[0.72rem] font-extrabold text-muted-foreground no-underline transition-colors hover:text-accent-strong max-nav:grid-cols-[7rem_minmax(0,1fr)] max-nav:justify-items-start max-[480px]:grid-cols-[5.5rem_minmax(0,1fr)]"
        href={project.data.url}
        target="_blank"
        rel="noreferrer"
        aria-label={`${project.data.urlLabel ?? '前往 App Store'}：${project.data.title}`}
      >
        <img
          class="h-auto w-full rounded-[10px] border border-border shadow-none max-nav:w-28 max-[480px]:w-[5.5rem]"
          src={project.data.qrCode}
          alt={project.data.qrCodeAlt ?? `${project.data.title} App Store 安装二维码`}
          width="512"
          height="512"
          loading="lazy"
        />
        <span>扫码安装</span>
      </a>
    </section>
  )
}
