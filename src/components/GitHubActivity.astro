---
import { ExternalLink } from '@lucide/astro';
import GitHubIcon from './GitHubIcon.astro';
import SectionHeading from './SectionHeading.astro';
import {
  getGitHubContributions,
  type GitHubContributionDay,
} from '../lib/github-contributions';

interface Props {
  username: string;
}

const { username } = Astro.props;
const calendar = await getGitHubContributions(username);
const today = new Date();
const profileURL = `https://github.com/${encodeURIComponent(username)}`;

function placeholderDays(): GitHubContributionDay[] {
  const end = new Date(Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate()));
  const start = new Date(end);
  start.setUTCDate(start.getUTCDate() - start.getUTCDay() - 52 * 7);

  const days: GitHubContributionDay[] = [];
  for (const date = new Date(start); date <= end; date.setUTCDate(date.getUTCDate() + 1)) {
    days.push({
      date: date.toISOString().slice(0, 10),
      count: 0,
      level: 0,
    });
  }
  return days;
}

const days = calendar?.days ?? placeholderDays();
const weeks = Array.from({ length: Math.ceil(days.length / 7) }, (_, index) =>
  days.slice(index * 7, index * 7 + 7),
);
const activeDays = days.filter((day) => day.count > 0).length;
let currentStreak = 0;
let longestStreak = 0;

for (const day of days) {
  if (day.count > 0) {
    currentStreak += 1;
    longestStreak = Math.max(longestStreak, currentStreak);
  } else {
    currentStreak = 0;
  }
}

const total = calendar?.total ?? 0;
const numberFormatter = new Intl.NumberFormat('zh-CN');
const syncDateFormatter = new Intl.DateTimeFormat('zh-CN', {
  month: 'short',
  day: 'numeric',
  timeZone: 'Asia/Shanghai',
});
const cellDateFormatter = new Intl.DateTimeFormat('zh-CN', {
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const chartLabel = calendar
  ? `@${username} 过去一年共有 ${numberFormatter.format(total)} 次 GitHub 贡献，活跃 ${activeDays} 天，最长连续活跃 ${longestStreak} 天。`
  : `暂时无法同步 @${username} 的 GitHub 活动。`;
---

<section class="pt-[clamp(4rem,8vw,6.5rem)]" aria-labelledby="github-activity-title">
  <SectionHeading
    kicker="OPEN SOURCE RHYTHM"
    title="GitHub 活动"
    id="github-activity-title"
    href={profileURL}
    actionLabel={`@${username}`}
  >
    <GitHubIcon slot="action-icon" size={18} />
  </SectionHeading>

  <div
    class="github-activity-card relative overflow-hidden rounded-[28px] border border-border/70 bg-[radial-gradient(circle_at_92%_-15%,color-mix(in_srgb,var(--accent)_18%,transparent)_0,transparent_34%),linear-gradient(145deg,var(--surface-raised),color-mix(in_srgb,var(--accent-soft)_34%,var(--surface-raised)))] p-[clamp(1.4rem,3.5vw,2.35rem)] shadow-card max-[480px]:rounded-[23px] max-[480px]:p-[1.15rem]"
    data-state={calendar ? 'ready' : 'fallback'}
  >
    <div
      class="relative z-1 grid grid-cols-[auto_auto_minmax(0,1fr)_auto] items-center gap-[clamp(0.9rem,2.5vw,1.5rem)] pb-[1.6rem] max-nav:grid-cols-[auto_1fr_auto]"
    >
      <div
        class="grid size-[3.6rem] -rotate-4 place-items-center rounded-[17px] bg-foreground text-surface shadow-[0_9px_24px_color-mix(in_srgb,var(--foreground)_18%,transparent)] max-[480px]:size-12 max-[480px]:rounded-[14px]"
        aria-hidden="true"
      >
        <GitHubIcon size={29} />
      </div>
      <div class="grid grid-cols-[auto_auto] items-baseline gap-x-[0.45rem]">
        <span
          class="col-span-full text-[0.76rem] font-[760] tracking-[0.1em] text-muted-foreground uppercase"
        >
          过去一年
        </span>
        <strong
          class="text-[clamp(2.2rem,5vw,3.35rem)] leading-none font-[880] tracking-[-0.065em] max-[480px]:text-[2.2rem]"
        >
          {calendar ? numberFormatter.format(total) : '—'}
        </strong>
        <small class="text-[0.82rem] font-[720] text-muted-foreground">次贡献</small>
      </div>
      <dl
        class="m-0 flex gap-[clamp(1rem,4vw,2.8rem)] border-l border-border pl-[clamp(0.4rem,2.5vw,1.8rem)] max-nav:col-span-full max-nav:row-start-2 max-nav:justify-start max-nav:border-t max-nav:border-l-0 max-nav:pt-4 max-nav:pl-0 max-[480px]:justify-between"
      >
        <div class="grid gap-[0.15rem]">
          <dt class="text-[0.76rem] font-[690] text-muted-foreground">活跃天数</dt>
          <dd class="m-0 text-[1.08rem] font-[830]">
            {calendar ? numberFormatter.format(activeDays) : '—'}
          </dd>
        </div>
        <div class="grid gap-[0.15rem]">
          <dt class="text-[0.76rem] font-[690] text-muted-foreground">最长连续</dt>
          <dd class="m-0 text-[1.08rem] font-[830]">
            {calendar ? `${longestStreak} 天` : '—'}
          </dd>
        </div>
      </dl>
      <p
        class="m-0 self-start text-[0.74rem] font-[680] text-muted-foreground max-nav:col-start-3 max-nav:row-start-1"
      >
        {
          calendar
            ? `同步于 ${syncDateFormatter.format(calendar.fetchedAt)}`
            : 'GitHub 数据暂时不可用'
        }
      </p>
    </div>

    <div
      class="github-contribution-chart relative z-1 rounded-[20px] border border-border/80 bg-surface/80 p-[clamp(0.85rem,2vw,1.3rem)] shadow-[inset_0_1px_0_color-mix(in_srgb,#fff_52%,transparent)] max-[480px]:rounded-2xl max-[480px]:p-[0.7rem]"
      role="img"
      aria-label={chartLabel}
      style={`--desktop-weeks: ${weeks.length}; --tablet-weeks: ${Math.min(40, weeks.length)}; --mobile-weeks: ${Math.min(26, weeks.length)};`}
    >
      <div class="github-contribution-weeks" aria-hidden="true">
        {
          weeks.map((week, weekIndex) => (
            <div
              class:list={[
                'github-contribution-week',
                {
                  'github-contribution-week-tablet-hidden': weekIndex < weeks.length - 40,
                  'github-contribution-week-mobile-hidden': weekIndex < weeks.length - 26,
                },
              ]}
            >
              {week.map((day) => (
                <span
                  class="github-contribution-day"
                  data-level={day.level}
                  title={`${cellDateFormatter.format(new Date(`${day.date}T00:00:00Z`))} · ${day.count} 次贡献`}
                />
              ))}
            </div>
          ))
        }
      </div>

      <div class="github-contribution-legend" aria-hidden="true">
        <span>少</span>
        {[0, 1, 2, 3, 4].map((level) => (
          <i data-level={level}></i>
        ))}
        <span>多</span>
      </div>
    </div>

    <a
      class="group relative z-1 mt-[1.2rem] inline-flex items-center gap-[0.45rem] text-[0.82rem] font-[790] text-accent-strong no-underline"
      href={profileURL}
    >
      <GitHubIcon size={18} />
      查看完整 GitHub 主页
      <ExternalLink
        class="transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        size={15}
        stroke-width={2.2}
      />
    </a>
  </div>
</section>

<style>
  .github-activity-card::after {
    position: absolute;
    top: -3.5rem;
    right: -2.75rem;
    width: 9rem;
    height: 9rem;
    border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

  .github-contribution-weeks {
    display: grid;
    grid-template-columns: repeat(var(--desktop-weeks), minmax(0, 1fr));
    gap: clamp(2px, 0.45vw, 5px);
  }

  .github-contribution-week {
    display: grid;
    min-width: 0;
    grid-template-rows: repeat(7, 1fr);
    gap: clamp(2px, 0.45vw, 5px);
  }

  .github-contribution-day,
  .github-contribution-legend i {
    display: block;
    border-radius: 3px;
    background: var(--activity-0);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--foreground) 4%, transparent);
  }

  .github-contribution-day {
    aspect-ratio: 1;
    transition:
      filter 140ms ease,
      transform 140ms ease;
  }

  .github-contribution-day:hover {
    filter: saturate(1.12) brightness(1.04);
    transform: scale(1.24);
  }

  .github-contribution-day[data-level="1"],
  .github-contribution-legend i[data-level="1"] {
    background: var(--activity-1);
  }

  .github-contribution-day[data-level="2"],
  .github-contribution-legend i[data-level="2"] {
    background: var(--activity-2);
  }

  .github-contribution-day[data-level="3"],
  .github-contribution-legend i[data-level="3"] {
    background: var(--activity-3);
  }

  .github-contribution-day[data-level="4"],
  .github-contribution-legend i[data-level="4"] {
    background: var(--activity-4);
  }

  .github-contribution-legend {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 0.28rem;
    margin-top: 0.7rem;
    color: var(--muted-foreground);
    font-size: 0.68rem;
    font-weight: 650;
  }

  .github-contribution-legend i {
    width: 0.65rem;
    height: 0.65rem;
  }

  .github-activity-card[data-state="fallback"] .github-contribution-chart {
    opacity: 0.62;
  }

  @media (max-width: 900px) {
    .github-contribution-weeks {
      grid-template-columns: repeat(var(--tablet-weeks), minmax(0, 1fr));
    }

    .github-contribution-week-tablet-hidden {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .github-contribution-weeks {
      grid-template-columns: repeat(var(--mobile-weeks), minmax(0, 1fr));
      gap: 4px;
    }

    .github-contribution-week {
      gap: 4px;
    }

    .github-contribution-week-mobile-hidden {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .github-contribution-weeks,
    .github-contribution-week {
      gap: 3px;
    }
  }
</style>
