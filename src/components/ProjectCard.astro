---
import { ArrowUpRight } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index = 0 } = Astro.props;
const projectNumber = String(index + 1).padStart(2, '0');
const isReader = project.id === 'myreader';
const isWhiteNoise = project.id === 'whitenoise';
const cardImage = project.data.cardImage;
const cardImageDark = project.data.cardImageDark;
---

<li class="min-w-0" data-project-card={project.id}>
  <a
    class:list={[
      'group relative flex min-h-[440px] flex-col overflow-hidden rounded-[28px] border border-border/70 bg-surface-raised text-foreground no-underline shadow-card transition-[box-shadow,transform] duration-[220ms] hover:-translate-y-[7px] hover:-rotate-[0.35deg] hover:shadow-card-lift min-[721px]:grid min-[721px]:min-h-[380px] min-[721px]:grid-cols-2 max-tablet:min-h-[410px] max-nav:min-h-[430px] max-nav:rounded-[23px]',
      {
        'border-transparent bg-[radial-gradient(circle_at_95%_0%,rgb(255_255_255/0.18),transparent_30%),linear-gradient(145deg,#5144e4,#7868f5)] text-white':
          isReader || isWhiteNoise,
      },
    ]}
    href={`/projects/${project.id}/`}
  >
    <div class="relative z-2 px-7 pt-[1.7rem] pb-4 max-[480px]:px-[1.35rem] max-[480px]:pt-[1.4rem] max-[480px]:pb-[0.8rem]">
      <div class="flex gap-4 text-[0.72rem] font-[850] tracking-[0.11em] text-current/68 uppercase">
        <span>{projectNumber}</span>
      </div>
      <div class="mt-5 flex min-w-0 items-center gap-[0.8rem]">
        <h3
          class="m-0 text-[clamp(1.75rem,3.5vw,2.5rem)] leading-[1.05] font-[850] tracking-[-0.055em]"
        >
          {project.data.title}
        </h3>
      </div>
      <p class="mt-[0.85rem] mb-0 text-[0.91rem] leading-[1.72] text-current/80">
        {project.data.description}
      </p>
      <div class="mt-4 flex flex-wrap gap-[0.45rem]">
        {
          project.data.tags.map((tag) => (
            <span class="rounded-full border border-current/18 bg-current/8 px-[0.52rem] py-1 text-[0.7rem] font-[750]">
              {tag}
            </span>
          ))
        }
      </div>
      <span class="mt-5 inline-flex items-center gap-[0.35rem] text-[0.83rem] font-[850]">
        查看项目 <ArrowUpRight size={18} stroke-width={2.2} />
      </span>
    </div>

    <div class:list={['project-card-preview', { 'project-card-preview-whitenoise': isWhiteNoise }]} aria-hidden="true">
      {
        isReader ? (
          <div class="reader-window">
            <div class="mock-window-bar">
              <span></span><span></span><span></span>
            </div>
            <div class="reader-window-body">
              <div class="reader-library">
                <i></i><i></i><i></i>
              </div>
              <div class="reader-document">
                <b>MyReader</b>
                <span></span><span></span><span></span><span></span>
                <small>42%</small>
              </div>
            </div>
          </div>
        ) : isWhiteNoise ? (
          <div class="whitenoise-preview">
            {
              cardImage && (
                <img
                  class="whitenoise-preview-image whitenoise-preview-image-light"
                  src={cardImage}
                  alt=""
                  width="645"
                  height="1333"
                  loading="lazy"
                />
              )
            }
            {
              cardImageDark && (
                <img
                  class="whitenoise-preview-image whitenoise-preview-image-dark"
                  src={cardImageDark}
                  alt=""
                  width="661"
                  height="1405"
                  loading="lazy"
                />
              )
            }
          </div>
        ) : (
          <div class="project-generic-preview">
            <strong>{project.data.title}</strong>
          </div>
        )
      }
    </div>
    <span
      class="absolute bottom-[1.55rem] left-7 z-3 text-[0.7rem] leading-none font-[850] tracking-[0.09em] text-current/72 uppercase max-nav:bottom-[1.1rem] max-nav:left-[1.35rem] max-nav:rounded-full max-nav:border max-nav:border-white/18 max-nav:bg-[rgb(40_32_128/0.68)] max-nav:px-[0.55rem] max-nav:py-[0.35rem] max-nav:text-white/78 max-nav:backdrop-blur-lg"
    >
      {project.data.status}
    </span>
  </a>
</li>

<style>
  :global([data-project-card]) :global(svg) {
    transition: transform 180ms ease;
  }

  :global([data-project-card]) :global(a:hover) :global(svg) {
    transform: translate(3px, -3px);
  }

  .project-card-preview {
    position: relative;
    z-index: 1;
    min-height: 175px;
    flex: 1;
    margin: 0 1.3rem -2rem;
  }

  .reader-window {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    min-height: 195px;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.26);
    border-radius: 17px 17px 0 0;
    background: rgb(255 255 255 / 0.94);
    box-shadow: 0 18px 42px rgb(20 20 74 / 0.26);
    color: #2a2d42;
    transform: perspective(800px) rotateX(2deg) rotateZ(-1.5deg);
    transform-origin: bottom center;
    transition: transform 260ms ease;
  }

  :global([data-project-card] a:hover) .reader-window {
    transform: perspective(800px) rotateX(0deg) rotateZ(0deg) translateY(-5px);
  }

  .mock-window-bar {
    display: flex;
    gap: 5px;
    align-items: center;
    height: 27px;
    padding-inline: 11px;
    border-bottom: 1px solid #e5e6ee;
    background: #f7f7fa;
  }

  .mock-window-bar span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #c9cbd7;
  }

  .mock-window-bar span:first-child {
    background: #fe7d76;
  }

  .mock-window-bar span:nth-child(2) {
    background: #ffd36a;
  }

  .mock-window-bar span:nth-child(3) {
    background: #61d59b;
  }

  .reader-window-body {
    display: grid;
    min-height: 168px;
    grid-template-columns: 34% 66%;
  }

  .reader-library {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    padding: 15px 12px;
    background: #eef0f7;
  }

  .reader-library i {
    display: block;
    min-height: 52px;
    border-radius: 5px;
    background: linear-gradient(145deg, #a879d1, #7255a2);
    box-shadow: 0 5px 10px rgb(52 47 88 / 0.12);
  }

  .reader-library i:nth-child(2) {
    background: linear-gradient(145deg, #6f9de3, #426bb1);
  }

  .reader-library i:nth-child(3) {
    background: linear-gradient(145deg, #e49f7e, #bd674d);
  }

  .reader-document {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 22px 20px;
    background: #fffdf8;
  }

  .reader-document b {
    margin-bottom: 4px;
    font-size: 0.8rem;
  }

  .reader-document > span {
    display: block;
    height: 5px;
    border-radius: 999px;
    background: #d8d4ce;
  }

  .reader-document > span:nth-of-type(2) {
    width: 88%;
  }

  .reader-document > span:nth-of-type(3) {
    width: 94%;
  }

  .reader-document > span:nth-of-type(4) {
    width: 62%;
  }

  .reader-document small {
    position: absolute;
    right: 14px;
    bottom: 10px;
    color: #8c8983;
    font-size: 0.65rem;
  }

  .whitenoise-preview {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-inline: 0.35rem;
  }

  .project-card-preview-whitenoise {
    min-height: 0;
    margin-bottom: 0;
  }

  .whitenoise-preview-image {
    position: relative;
    z-index: 1;
    display: block;
    width: auto;
    height: 100%;
    max-width: 100%;
    object-fit: contain;
    object-position: center bottom;
  }

  .whitenoise-preview-image-dark {
    display: none;
  }

  :global(:root[data-theme="dark"]) .whitenoise-preview-image-light {
    display: none;
  }

  :global(:root[data-theme="dark"]) .whitenoise-preview-image-dark {
    display: block;
  }

  .project-generic-preview {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    min-height: 195px;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 17px 17px 0 0;
    background: var(--surface);
    color: var(--accent-strong);
    font-size: 1.3rem;
    font-weight: 850;
  }

  @media (min-width: 721px) {
    .project-card-preview {
      min-height: 260px;
      margin: 2.2rem -2rem -2rem 0;
    }

    .project-card-preview-whitenoise {
      min-height: 0;
      margin: 0;
    }

    .whitenoise-preview {
      align-items: stretch;
      justify-content: flex-end;
      padding: 1.5rem;
    }
  }

  @media (max-width: 720px) {
    .project-card-preview-whitenoise {
      position: absolute;
      z-index: 1;
      inset: 0;
      margin: 0;
      pointer-events: none;
    }

    .project-card-preview-whitenoise .whitenoise-preview {
      display: block;
      padding: 0;
    }

    .project-card-preview-whitenoise .whitenoise-preview-image {
      position: absolute;
      right: clamp(0.6rem, 3vw, 1.2rem);
      bottom: 0.75rem;
      width: auto;
      max-width: none;
      height: 96%;
      opacity: 0.22;
      mask-image: linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.42) 30%, #000 64%);
    }

    :global(:root[data-theme="dark"])
      .project-card-preview-whitenoise
      .whitenoise-preview-image {
      opacity: 0.46;
    }
  }

  @media (max-width: 480px) {
    .project-card-preview {
      margin-right: 0.8rem;
      margin-left: 0.8rem;
    }

    .project-card-preview-whitenoise {
      margin: 0;
    }
  }
</style>
