---
import { ArrowDown } from '@lucide/astro';
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<article class="whitenoise-project-page">
  <a class="back-link whitenoise-back-link" href="/projects/">
    <span aria-hidden="true">←</span> 返回项目
  </a>

  <header class="whitenoise-product-header">
    <div class="whitenoise-product-summary">
      <div class="whitenoise-product-lockup">
        {
          project.data.icon && (
            <img
              src={project.data.icon}
              alt=""
              width="1024"
              height="1024"
              fetchpriority="high"
            />
          )
        }
        <div class="whitenoise-product-copy">
          <div class="whitenoise-product-title">
            <h1>{project.data.title}</h1>
            <span>{project.data.status}</span>
          </div>
          <p>{project.data.description}</p>
        </div>
      </div>

      {
        project.data.url && (
          <a
            class="whitenoise-store-link"
            href="#whitenoise-install"
            aria-label={`前往安装 ${project.data.title}`}
          >
            下载
            <ArrowDown size={18} stroke-width={2.3} />
          </a>
        )
      }
    </div>

    <section class="whitenoise-screenshots" aria-labelledby="whitenoise-screenshot-title">
      <h2 id="whitenoise-screenshot-title">应用截图</h2>
      <div
        class="whitenoise-screenshots-scroller"
        role="region"
        aria-label="WhiteNoise 应用截图，可横向滚动"
        tabindex="0"
      >
        {
          project.data.screenshots.map((screenshot, index) => (
            <figure>
              <img
                src={screenshot.src}
                alt={screenshot.alt}
                width="830"
                height="1800"
                loading={index === 0 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : undefined}
              />
            </figure>
          ))
        }
      </div>
    </section>
  </header>

  <div class="prose article-content whitenoise-article-content">
    <Content />
  </div>

  {
    project.data.url && project.data.qrCode && (
      <section
        id="whitenoise-install"
        class="project-install-card whitenoise-install-card"
        aria-labelledby="whitenoise-install-heading"
      >
        <div class="project-install-copy">
          <div class="project-install-identity">
            {
              project.data.icon && (
                <img
                  src={project.data.icon}
                  alt=""
                  width="1024"
                  height="1024"
                  loading="lazy"
                />
              )
            }
            <div>
              <p>AVAILABLE ON THE APP STORE</p>
              <h2 id="whitenoise-install-heading">安装 {project.data.title}</h2>
            </div>
          </div>
          <p>点击按钮前往 App Store，或使用 iPhone / iPad 相机扫描二维码。</p>
          <a href={project.data.url} target="_blank" rel="noreferrer">
            {project.data.urlLabel ?? '前往 App Store'}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
        <a
          class="project-install-qr"
          href={project.data.url}
          target="_blank"
          rel="noreferrer"
          aria-label={`${project.data.urlLabel ?? '前往 App Store'}：${project.data.title}`}
        >
          <img
            src={project.data.qrCode}
            alt={project.data.qrCodeAlt ?? `${project.data.title} App Store 安装二维码`}
            width="512"
            height="512"
            loading="lazy"
          />
          <span>扫码安装</span>
        </a>
      </section>
    )
  }
</article>
