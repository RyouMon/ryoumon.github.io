---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectInstallCard from '../../components/ProjectInstallCard.astro';
import WhiteNoiseProjectDetail from '../../components/WhiteNoiseProjectDetail.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');

  return projects.map((project) => ({
    params: { slug: project.id },
    props: project,
  }));
}

type Props = CollectionEntry<'projects'>;

const project = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
  {
    project.data.detailLayout === 'whitenoise' ? (
      <WhiteNoiseProjectDetail project={project} />
    ) : (
      <article class="w-full">
        <a
          class="group mb-[2.7rem] inline-flex items-center gap-[0.45rem] text-[0.88rem] font-[720] text-muted-foreground no-underline hover:text-accent-strong"
          href="/projects/"
        >
          <span
            class="transition-transform duration-150 group-hover:-translate-x-1"
            aria-hidden="true"
          >
            ←
          </span>
          返回项目
        </a>

        <header>
          <div class="flex min-w-0 items-start gap-5 max-[480px]:gap-4">
            {
              project.data.icon && (
                <img
                  class="size-24 shrink-0 rounded-[23%] max-tablet:size-20 max-[480px]:size-16"
                  src={project.data.icon}
                  alt=""
                  width="1024"
                  height="1024"
                  fetchpriority="high"
                />
              )
            }
            <div class="min-w-0">
              <h1
                class="m-0 inline-block text-[clamp(2.5rem,7vw,4.25rem)] leading-[1.02] font-[860] tracking-[-0.065em] text-accent-strong"
              >
                {project.data.title}
              </h1>
              <p class="mt-4 mb-0 max-w-[42rem] text-[1.03rem] leading-[1.8] text-muted-foreground">
                {project.data.description}
              </p>
              <div class="mt-[0.9rem] flex flex-wrap gap-[0.55rem] text-[0.84rem] font-[720] text-muted-foreground">
                <span>{project.data.status}</span>
                {
                  project.data.stack.length > 0 && (
                    <>
                      <span aria-hidden="true">·</span>
                      <span>{project.data.stack.join(' · ')}</span>
                    </>
                  )
                }
              </div>
            </div>
          </div>
        </header>

        <div class="prose mt-10">
          <Content />
        </div>

        {
          project.data.url && project.data.qrCode ? (
            <>
              <hr class="my-[2.3rem] border-0 border-t border-dashed border-border" />
              <ProjectInstallCard project={project} />
            </>
          ) : (
            (project.data.url || project.data.repository) && (
              <>
                <hr class="my-[2.3rem] border-0 border-t border-dashed border-border" />
                <div class="flex flex-wrap gap-[0.8rem]">
                  {project.data.url && (
                    <a
                      class="inline-flex min-h-[2.7rem] items-center rounded-[10px] bg-accent-soft px-[0.85rem] py-[0.45rem] font-extrabold text-accent-strong no-underline transition-transform hover:-translate-y-0.5"
                      href={project.data.url}
                      target="_blank"
                      rel="noreferrer"
                    >
                      {project.data.urlLabel ?? '访问项目'} <span aria-hidden="true">↗</span>
                    </a>
                  )}
                  {project.data.repository && (
                    <a
                      class="inline-flex min-h-[2.7rem] items-center rounded-[10px] bg-accent-soft px-[0.85rem] py-[0.45rem] font-extrabold text-accent-strong no-underline transition-transform hover:-translate-y-0.5"
                      href={project.data.repository}
                      target="_blank"
                      rel="noreferrer"
                    >
                      查看源码 <span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </>
            )
          )
        }
      </article>
    )
  }
</BaseLayout>
