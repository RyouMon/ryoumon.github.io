---
import { getCollection } from 'astro:content';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHeading from '../../components/PageHeading.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title="项目" description="Wen 正在开发和持续维护的项目。">
  <Breadcrumb current="项目" />
  <PageHeading
    title="项目"
    description="正在开发、维护或持续思考的产品，以及它们背后的实现选择。"
  />

  <ul class="m-0 grid list-none gap-6 p-0">
    {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
  </ul>
</BaseLayout>
