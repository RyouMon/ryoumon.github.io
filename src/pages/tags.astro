---
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHeading from '../components/PageHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="标签" description="按主题浏览 Wen 的文章。">
  <Breadcrumb current="标签" />
  <PageHeading title="标签" description="散落在文章里的主题线索。" />
  <p
    class="m-0 min-h-36 rounded-[18px] border border-dashed border-border bg-surface/70 p-6 text-muted-foreground"
  >
    新的文章标签会在这里出现。
  </p>
</BaseLayout>
